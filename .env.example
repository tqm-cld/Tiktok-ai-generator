# Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.
# Ohne Schlüssel läuft das Programm im Demo-Modus (Beispielgeschichte + Farbverläufe).

# Claude API-Schlüssel für die Geschichten: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Kostenloser Pexels-Schlüssel für Stock-Videos/-Bilder: https://www.pexels.com/api/
PEXELS_API_KEY=

# Stimme (Liste aller Stimmen: edge-tts --list-voices)
TTS_VOICE=de-DE-FlorianMultilingualNeural
# Sprechtempo, z.B. +10% oder -5%
TTS_RATE=+5%

# Sprache der Geschichte
STORY_LANGUAGE=Deutsch

# Lautstärke der Hintergrundmusik (0.0 bis 1.0)
MUSIC_VOLUME=0.12

# Zugriff vom iPhone im selben WLAN (1 = an, 0 = nur dieser Computer)
PHONE_ACCESS=1
# Zugangscode fürs iPhone – wird beim ersten Start automatisch erzeugt
# ACCESS_CODE=
